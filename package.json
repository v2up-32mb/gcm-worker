{
  "name": "gcm-worker",
  "version": "0.1.0",
  "private": true,
  "description": "GCM 二进制多路复用协议的 Cloudflare Worker 服务端（对端 github.com/v2up-32mb/gcm）",
  "type": "module",
  "scripts": {
    "check": "npm run check:syntax && npm run check:protocol && npm test",
    "check:syntax": "node --check worker.js",
    "check:protocol": "node scripts/check-protocol.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
